/* =========================================================
   입장 코드 게이트
   코드 레코드 형태: { code, startAt(ISO), endAt(ISO), maxUses(0=무제한), usedCount, note, createdAt }
   저장 위치: window.storage (shared:true) key = 'code:' + code
   ========================================================= */

async function getCodeRecord(code){
  try{
    const res = await window.storage.get('code:' + code, true);
    return res ? JSON.parse(res.value) : null;
  }catch(e){
    return null;
  }
}

async function saveCodeRecord(record){
  await window.storage.set('code:' + record.code, JSON.stringify(record), true);
}

async function listCodeRecords(){
  try{
    const listRes = await window.storage.list('code:', true);
    if (!listRes || !listRes.keys) return [];
    const records = [];
    for (const key of listRes.keys){
      try{
        const res = await window.storage.get(key, true);
        if (res) records.push(JSON.parse(res.value));
      }catch(e){}
    }
    records.sort((a,b)=> new Date(b.createdAt) - new Date(a.createdAt));
    return records;
  }catch(e){
    return [];
  }
}

function codeStatus(record){
  const now = new Date();
  const start = new Date(record.startAt);
  const end = new Date(record.endAt);
  if (now < start) return 'pending';
  if (now > end) return 'expired';
  if (record.maxUses > 0 && record.usedCount >= record.maxUses) return 'expired';
  return 'active';
}

let currentAccessCode = null;

document.getElementById('gate-submit').addEventListener('click', submitGateCode);
document.getElementById('gate-code-input').addEventListener('keydown', (e)=>{
  if (e.key === 'Enter') submitGateCode();
});

async function submitGateCode(){
  const input = document.getElementById('gate-code-input');
  const errEl = document.getElementById('gate-error');
  const btn = document.getElementById('gate-submit');
  const code = input.value.trim().toUpperCase();

  errEl.textContent = '';
  if (!code){
    errEl.textContent = '코드를 입력해 주세요.';
    return;
  }
  btn.disabled = true;
  btn.textContent = '확인 중...';

  const record = await getCodeRecord(code);
  btn.disabled = false;
  btn.textContent = '입장하기';

  if (!record){
    errEl.textContent = '유효하지 않은 코드입니다.';
    return;
  }
  const status = codeStatus(record);
  if (status === 'pending'){
    errEl.textContent = `아직 사용할 수 없는 코드입니다. (시작: ${fmtDate(record.startAt)})`;
    return;
  }
  if (status === 'expired'){
    if (record.maxUses > 0 && record.usedCount >= record.maxUses){
      errEl.textContent = '사용 횟수를 초과한 코드입니다.';
    } else {
      errEl.textContent = `사용 기간이 지난 코드입니다. (종료: ${fmtDate(record.endAt)})`;
    }
    return;
  }

  // 유효 -> 입장 처리
  record.usedCount = (record.usedCount || 0) + 1;
  await saveCodeRecord(record);
  currentAccessCode = record;
  enterShop(record);
}

function enterShop(record){
  document.getElementById('gate-screen').style.display = 'none';
  document.getElementById('shop-content').style.display = 'block';
  document.getElementById('access-tag').textContent =
    `입장 코드: ${record.code} · ${fmtDate(record.endAt)}까지 유효`;
  renderCatalog();
  renderCart();
}

