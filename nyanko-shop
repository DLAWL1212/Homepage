function onAdd(btn){
  const name = btn.dataset.name;
  const price = Number(btn.dataset.price);
  const existing = cart.find(c => c.name === name);
  if (existing) existing.qty += 1;
  else cart.push({name, price, qty:1});

  btn.textContent = '담김 ✓';
  btn.classList.add('added');
  setTimeout(()=>{ btn.textContent='담기'; btn.classList.remove('added'); }, 900);

  renderCart();
}

function changeQty(idx, delta){
  cart[idx].qty += delta;
  if (cart[idx].qty <= 0) cart.splice(idx,1);
  renderCart();
}

function removeItem(idx){
  cart.splice(idx,1);
  renderCart();
}

function cartTotal(){
  return cart.reduce((sum,c)=> sum + c.price*c.qty, 0);
}

function renderCart(){
  const itemsEl = document.getElementById('cart-items');
  const countEl = document.getElementById('cart-count');
  const totalEl = document.getElementById('cart-total');
  const btn = document.getElementById('checkout-btn');
  const warn = document.getElementById('min-warn');

  const totalQty = cart.reduce((s,c)=>s+c.qty,0);
  countEl.textContent = `담긴 상품 ${totalQty}개`;

  if (cart.length === 0){
    itemsEl.innerHTML = `<div class="cart-empty">아직 담은 상품이 없어요.<br>왼쪽에서 원하는 항목을 선택해 주세요.</div>`;
  } else {
    itemsEl.innerHTML = cart.map((c, idx) => `
      <div class="cart-item">
        <span class="cart-item-name">${c.name}</span>
        <div class="qty-ctrl">
          <button onclick="changeQty(${idx},-1)">−</button>
          <span>${c.qty}</span>
          <button onclick="changeQty(${idx},1)">+</button>
        </div>
        <span class="cart-item-price">${money(c.price*c.qty)}</span>
        <button class="cart-remove" onclick="removeItem(${idx})">✕</button>
      </div>
    `).join('');
  }

  const total = cartTotal();
  totalEl.textContent = money(total);

  const meetsMin = total >= 200;
  warn.style.display = (cart.length > 0 && !meetsMin) ? 'block' : 'none';
  btn.disabled = cart.length === 0 || !meetsMin;
}

