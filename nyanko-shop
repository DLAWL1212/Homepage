      <div class="order-id">${orderId}</div>
      <p class="note">주문이 정상적으로 접수되었습니다. 입력하신 연락처로 재화 지급 및 진행 상황을 안내드립니다.<br>보통 5~30분 이내 처리됩니다.</p>
      <button class="close-done" onclick="afterDone()">확인</button>
    </div>
  `;
}

function afterDone(){
  cart = [];
  renderCart();
  closeOverlay();
}
</script>
</body>
</html>
