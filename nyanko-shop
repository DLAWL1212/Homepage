async function createNewCode(){
  const errEl = document.getElementById('admin-create-error');
  errEl.textContent = '';

  const code = document.getElementById('new-code').value.trim().toUpperCase();
  const startAt = document.getElementById('new-start').value;
  const endAt = document.getElementById('new-end').value;
  const maxUses = Number(document.getElementById('new-maxuses').value) || 0;
  const note = document.getElementById('new-note').value.trim();

  if (!code || !startAt || !endAt){
    errEl.textContent = '코드, 시작 일시, 종료 일시를 모두 입력해 주세요.';
    return;
  }
  if (new Date(endAt) <= new Date(startAt)){
    errEl.textContent = '종료 일시는 시작 일시보다 늦어야 합니다.';
    return;
  }
  const existing = await getCodeRecord(code);
  if (existing){
    errEl.textContent = '이미 존재하는 코드입니다. 다른 코드를 사용해 주세요.';
    return;
  }

  const record = {
    code,
    startAt: new Date(startAt).toISOString(),
    endAt: new Date(endAt).toISOString(),
    maxUses,
    usedCount: 0,
    note,
    createdAt: new Date().toISOString(),
  };
  await saveCodeRecord(record);
  document.getElementById('new-code').value = randomCode();
  document.getElementById('new-note').value = '';
  await refreshCodeList();
}

async function refreshCodeList(){
  const wrap = document.getElementById('code-list-wrap');
  const records = await listCodeRecords();

  if (records.length === 0){
    wrap.innerHTML = '<div class="admin-empty">아직 발급된 코드가 없어요.</div>';
    return;
  }

  const statusLabel = { active:'사용 가능', pending:'대기중', expired:'만료' };
  const statusClass = { active:'status-active', pending:'status-pending', expired:'status-expired' };

  wrap.innerHTML = `
    <table class="code-table">
      <thead>
        <tr>
          <th>코드</th><th>기간</th><th>사용</th><th>메모</th><th>상태</th><th></th>
        </tr>
      </thead>
      <tbody>
        ${records.map(r => {
          const st = codeStatus(r);
          return `
            <tr>
              <td><strong>${r.code}</strong></td>
              <td>${fmtDate(r.startAt)}<br>~ ${fmtDate(r.endAt)}</td>
              <td>${r.usedCount || 0}${r.maxUses > 0 ? ' / ' + r.maxUses : ' / ∞'}</td>
              <td>${r.note || '-'}</td>
              <td><span class="code-status ${statusClass[st]}">${statusLabel[st]}</span></td>
              <td><button class="del-code" data-code="${r.code}">삭제</button></td>
            </tr>
          `;
        }).join('')}
      </tbody>
    </table>
  `;

  wrap.querySelectorAll('.del-code').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      if (!confirm(`코드 "${btn.dataset.code}"를 삭제할까요?`)) return;
      try{
        const res = await window.storage.get('code:' + btn.dataset.code, true);
        if (res){
          await window.storage.delete('code:' + btn.dataset.code, true);
        }
      }catch(e){}
      await refreshCodeList();
    });
  });
}

